{
  "private": true,
  "scripts": {
    "check": "node --run lint && node --run typecheck",
    "build": "pnpm --filter website build",
    "lint": "biome check",
    "typecheck": "pnpm --filter website exec astro sync && pnpm --filter website exec tsc --noEmit",
    "fix": "biome check --fix",
    "format": "biome check --fix",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.ts",
    "changeset:publish": "node scripts/changeset-publish.ts"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.2.1"
}
